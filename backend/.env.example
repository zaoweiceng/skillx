SKILLX_DATABASE_URL=sqlite+aiosqlite:///./skillx.db
SKILLX_ARTIFACT_ROOT=./artifacts
SKILLX_RUNTIME_CREDENTIALS_PATH=./.runtime-credentials
SKILLX_CAPABILITY_ROOT=../capabilities/skillx
SKILLX_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
SKILLX_WORKER_ID=worker-local
SKILLX_WORKER_POLL_SECONDS=0.5
SKILLX_LEASE_SECONDS=30
SKILLX_AUTO_CREATE_SCHEMA=false
SKILLX_AGENT_BUILTIN_ENABLED=true
SKILLX_AGENT_RUNTIME_TYPE=unavailable
SKILLX_AGENT_COMMAND=
SKILLX_AGENT_ALLOWED_EXECUTABLES=["traex"]
SKILLX_AGENT_ENDPOINT=
SKILLX_AGENT_MODEL=
SKILLX_AGENT_API_KEY_ENV=SKILLX_AGENT_API_KEY
SKILLX_LLM_RUNTIME_TYPE=unavailable
SKILLX_LLM_ENDPOINT=
SKILLX_LLM_MODEL=
SKILLX_LLM_API_KEY_ENV=SKILLX_LLM_API_KEY
# 兼容旧配置；新部署优先使用上面的 SKILLX_AGENT_* / SKILLX_LLM_*。
SKILLX_MODEL_ENDPOINT=
SKILLX_MODEL_NAME=
SKILLX_MODEL_API_KEY_ENV=SKILLX_MODEL_API_KEY
SKILLX_AGENT_PROVIDER_TYPE=unavailable
SKILLX_TRAEX_COMMAND=
