{
  "apiVersion": "workflow.platform/v1",
  "kind": "Workflow",
  "metadata": {
    "name": "greeting",
    "capability": {
      "summary": "根据姓名生成确定性的问候语。",
      "useWhen": ["用户希望向明确姓名的人生成问候语"],
      "doNotUseWhen": ["用户要求发送消息或执行其他副作用"],
      "examples": ["问候 Alice"],
      "tags": ["问候", "文本"]
    }
  },
  "spec": {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "title": "姓名",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "uiSchema": {},
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "nodes": [
      {
        "id": "input",
        "type": "input",
        "displayName": "输入"
      },
      {
        "id": "format",
        "type": "transform",
        "displayName": "生成问候",
        "input": {
          "name": "${input.name}"
        },
        "config": {
          "operation": "template",
          "template": "你好，{name}"
        }
      },
      {
        "id": "output",
        "type": "output",
        "displayName": "输出",
        "input": {
          "message": "${format.output.text}"
        }
      }
    ],
    "edges": [
      {
        "source": "input",
        "target": "format"
      },
      {
        "source": "format",
        "target": "output"
      }
    ],
    "policies": {
      "maxDurationSeconds": 60,
      "maxParallelNodes": 2
    }
  }
}
